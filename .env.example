PORT=4443
VITE_BACKEND_URL=https://<server-ip>:4443
FRONTEND_URL=https://<your-frontend-domain>
JWT_SECRET=supersecretkey_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Real SMTP provider values for sending email to actual inboxes.
# Examples: Gmail SMTP, Outlook/Office365 SMTP, Brevo, SendGrid SMTP, Mailgun SMTP.
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=ArtSpace <no-reply@your-domain.com>