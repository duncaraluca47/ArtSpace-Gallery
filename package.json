  "scripts": {
    "build": "vite build",
    "build:client": "VITE_BACKEND_URL=$VITE_BACKEND_URL vite build",
    "build:client:win": "set VITE_BACKEND_URL=%VITE_BACKEND_URL%&& vite build",
    "dev": "vite",
    "backend:dev": "tsx watch src/backend/server.ts",
    "backend:start": "tsx src/backend/server.ts",
    "prisma:seed": "ts-node prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
